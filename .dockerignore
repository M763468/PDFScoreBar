# Ignore virtual environments
.venv*/

# Ignore log directories
logs/
logs_user/

# Ignore local build outputs, datasets, and analysis artifacts.  The canonical
# runtime receives the repository through a bind mount, so these are not image
# inputs and would otherwise make the final COPY layer unnecessarily large.
artifacts/
datasets/
temp/
graphify-out/
.mypy_cache/
.ruff_cache/

# Ignore local production model cache
.model_cache/

# Ignore data directory
data/

# Python artifacts
__pycache__/
*.pyc
*.tmp
*.swp

# Version control and agent-specific files
.git/
.dockerignore
.gitignore
.gitmodules
.serena/

# Exclude other external dependencies not needed for this SR image
external/omr_dln/
external/grounding_dino/
external/models/
