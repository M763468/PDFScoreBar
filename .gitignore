# Serena & AI tool folders
.ai/
.serena/

# VSCode user settings
.vscode/

# Python build artifacts and cache
__pycache__/
*.pyc
*.pyo
*.pyd
build/
dist/
*.egg-info/

# Virtual environments
env/
.toolvenv/
venv/
.venv*/
.venv*
.env

# Debug outputs
debug_outputs/
logs/
!logs/README.md
temp.txt

# Local build logs (keep out of repo root)
docker_build_*.log

# OS generated files
.DS_Store
Thumbs.db

# NOTE: Be careful about ignoring the 'data' directory.
# If you have large files you want to ignore inside 'data',
# list them specifically. For example:
# data/large_model.pkl
data/*
!data/.gitignore
!data/README.md
!data/training/
!data/evaluation/
!data/workbench/
!data/**/.gitkeep
output/*
*.pt
*.pth

# Third-party clones (kept locally under external/)
external/homr/
external/omr_dln/
external/realesrgan/
external/grounding_dino/
temp_review_images/

# Large datasets
datasets/
logs/analysis/
logs/archive/
logs/system/
/tmp/
