# Base image from Dockerfile.homr for consistency with CUDA and Ubuntu version
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

# Set up environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install essential packages and Python 3.11 and uv
RUN apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3-pip \
    wget git curl build-essential \
    libgl1 libglib2.0-0 tzdata \
    && rm -rf /var/lib/apt/lists/*

# Use python3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Install uv (via pip to manage local venvs)
RUN pip install uv

# Set working directory inside the container
WORKDIR /workspace

# Copy project source code
COPY . /workspace

# Create virtual environment for SR evaluation
RUN uv venv /opt/venv_sr

# Activate the venv for subsequent commands (uv commands can also target it)
# Add venv to PATH, but directly target python executable for robustness
ENV PATH="/opt/venv_sr/bin:$PATH"

# Ensure `pip` exists in the venv (needed for a few explicit uninstall/install steps).
RUN /opt/venv_sr/bin/python -m ensurepip --upgrade && \
    /opt/venv_sr/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Install dependencies (realesrgan requirements + ultralytics)
# Note: uv will resolve compatible versions.
RUN uv pip install -r external/realesrgan/requirements.txt ultralytics

# Apply basicsr patch for torchvision compatibility
# The path inside the venv depends on the Python version. For Python 3.11, it's lib/python3.11/site-packages
# This is a temporary patch as discussed.
RUN sed -i 's/from torchvision.transforms.functional_tensor import rgb_to_grayscale/from torchvision.transforms.functional import rgb_to_grayscale/g' /opt/venv_sr/lib/python3.11/site-packages/basicsr/data/degradations.py

# Install homr (and its runtime deps) and pymupdf into the same venv so SR and homr execution share one environment.
RUN uv pip install ./external/homr pymupdf

# Prefer GPU onnxruntime for performance parity with `homr_eval_gpu`.
RUN /opt/venv_sr/bin/python -m pip uninstall -y onnxruntime && \
    /opt/venv_sr/bin/python -m pip install --no-deps onnxruntime-gpu==1.22.0

# Ensure realesrgan model weights exist in the image.
# (They may already be present via COPY from the repo; download only if missing.)
RUN test -f external/realesrgan/weights/RealESRGAN_x4plus.pth || \
    wget https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth -P external/realesrgan/weights

# Set the entrypoint to keep the container running
CMD ["tail", "-f", "/dev/null"]
