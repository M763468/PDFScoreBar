ARG BASE_IMAGE=pdfscore_pipeline_gpu
FROM ${BASE_IMAGE}

ARG HOMR_SOURCE_COMMIT

USER root

COPY . /opt/issue245_homr

RUN test -n "${HOMR_SOURCE_COMMIT}" && \
    test -f /opt/issue245_homr/homr/segmentation/segnet_155-1240eedca553155b3c75fc9c7f643465383430a0.onnx && \
    printf '%s\n' "${HOMR_SOURCE_COMMIT}" > /opt/issue245_homr_commit.txt

# Restore the numerical/runtime versions recovered from the local HOMR venv and
# the historical Dockerfile.sr_eval. Keep the remaining managed dependencies
# fixed so the candidate remains reproducible and narrowly scoped.
RUN /opt/venv_pipeline/bin/python -m pip uninstall -y \
      numpy opencv-python opencv-python-headless \
      onnxruntime onnxruntime-gpu || true && \
    /opt/venv_pipeline/bin/python -m pip install --no-cache-dir --no-deps \
      numpy==2.2.6 \
      opencv-python-headless==4.12.0.88 \
      onnxruntime-gpu==1.22.0

ENV PYTHONPATH="/opt/issue245_homr"

LABEL issue245.homr.source_commit="${HOMR_SOURCE_COMMIT}"
LABEL issue245.homr.snapshot_kind="local-clean-archive-with-retained-models"
